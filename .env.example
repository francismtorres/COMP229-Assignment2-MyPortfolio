# Copy this file to ".env" (same folder as server.js) and fill in your own values.
# The real .env file is listed in .gitignore and must NEVER be committed or screenshotted.

# Port the Express server listens on
PORT=3000

# MongoDB connection string. The database name ("Portfolio") is the part after the host.
# Local MongoDB:  mongodb://127.0.0.1:27017/Portfolio
# MongoDB Atlas:  mongodb+srv://<username>:<password>@<cluster-host>/Portfolio?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/Portfolio

# Long random string used to sign JWTs, e.g. generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=1d

# Where the React (Vite) dev server runs (used by the asset redirect router)
CLIENT_URL=http://localhost:5173
